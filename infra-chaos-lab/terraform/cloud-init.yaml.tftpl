#cloud-config

package_update: true
package_upgrade: false

packages:
  - curl
  - wget
  - git
  - iptables
  - iproute2
  - jq
  - htop
  - ca-certificates

write_files:
  - path: /opt/helm-values/values-argocd.yaml
    permissions: '0644'
    encoding: b64
    content: ${values_argocd_b64}

  - path: /opt/helm-values/values-prometheus.yaml
    permissions: '0644'
    encoding: b64
    content: ${values_prometheus_b64}

  - path: /opt/k8s/application-baseline.yaml
    permissions: '0644'
    encoding: b64
    content: ${application_baseline_b64}

  - path: /usr/local/bin/bootstrap-cluster.sh
    permissions: '0755'
    encoding: b64
    content: ${bootstrap_script_b64}

runcmd:
  - /usr/local/bin/bootstrap-cluster.sh
